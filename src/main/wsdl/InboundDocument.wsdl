<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="InboundDocument" targetNamespace="http://xp.ponton.de/eda/v320" xmlns:oe="http://xp.ponton.de/eda/v320"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <wsdl:types>
        <xsd:schema targetNamespace="http://xp.ponton.de/eda/v320">
            <xsd:include schemaLocation="../xsd_org/InboundDocument.xsd" />
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="sendDocumentRequest">
        <wsdl:part element="oe:InboundDocument" name="parameters" />
    </wsdl:message>
    <wsdl:portType name="InboundDocumentPort">
        <wsdl:operation name="sendDocument">
            <wsdl:input message="oe:sendDocumentRequest" />
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="InboundDocument4SOAP" type="oe:InboundDocumentPort">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http" />
        <wsdl:operation name="sendDocument">
            <soap:operation soapAction="http://xp.ponton.de/eda/v320/inboundDocument" />
            <wsdl:input>
                <soap:body use="literal" />
            </wsdl:input>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="InboundDocumentService">
        <wsdl:port binding="oe:InboundDocument4SOAP" name="InboundDocumentSOAP">
            <soap:address location="http://localhost/inboundDocument" />
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>