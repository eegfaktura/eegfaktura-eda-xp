<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests log to the console only (no file appender), in the JVM's zone (Europe/Vienna, build.sbt).
     Noisy libraries at WARN; LogCapture (testsupport) attaches to the root logger when a test asserts a log line. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder>
            <pattern>%date{ISO8601} %-5level [%thread] %logger{0} - %msg tenant=%X{tenant:-}%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="io.moquette" level="WARN"/>
    <logger name="com.opentable" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="slick" level="WARN"/>
    <logger name="org.apache.pekko" level="WARN"/>
    <logger name="org.eclipse.paho" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
